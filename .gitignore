# Obfuscation related
app.*.map.json

# ─── npd_guard — sealed-value pipeline ────────────────────────
# Recipe carries the raw endpoint URL / AppsFlyer dev key /
# Firebase project number. Only the sealed byte arrays that
# `tool/npd_pack.dart` emits into `rust/npd_guard/src/sealed.rs`
# ever land in the repo.
tool/npd_guard.recipe.json
# Cargo build artefacts for the Rust guard.
rust/npd_guard/target/
# Android `google-services.json` DOES carry build-signing-adjacent
# fields that must not leak into the public repo (Play Services client
# IDs tied to the keystore, OAuth web client secret). The iOS
# `GoogleService-Info.plist`, on the other hand, is baked into every
# shipped IPA and the Firebase iOS SDK publishes all of its contents
# at runtime, so hiding it here only breaks CI (`Build input file
# cannot be found`) without adding any protection. Keep the Android
# file ignored, keep the iOS one committed.
android/app/google-services.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
